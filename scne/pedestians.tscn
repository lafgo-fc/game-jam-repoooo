script/source = "extends CharacterBody2D
#sctipts and scenes import
@onready var npc_1 = $\"npc 1\"
@onready var traffic_light = $\"../../TrafficLight\"
@onready var npc_2 = $\"npc 2\"
@onready var npc_3 =  $\"npc 3\"
@onready var npc_4 = $\"npc 4\"
@onready var npc_5 = $\"npc 5\"
@onready var npc_6 = $\"npc 6\"


# adding markers
@onready var pt_1 = $\"../../waypoints/p1\"
@onready var pt_2 = $\"../../waypoints/p2\"
@onready var pt_3 = $\"../../waypoints/p3\"
@onready var pt_4 = $\"../../waypoints/p4\"
@onready var pt_5 = $\"../../waypoints/p5\"
@onready var pt_6 = $\"../../waypoints/p6\"
@onready var pt_7 = $\"../../waypoints/p7\"
@onready var pt_8 = $\"../../waypoints/p8\"
@onready var pt_9 = $\"../../waypoints/p9\"
@onready var pt_10 = $\"../../waypoints/p10\"
@onready var pt_11 = $\"../../waypoints/p11\"

# essential vars
var near_pt : Marker2D
var last_direction : String
var npc_inside : bool = false
var npc_name : AnimatedSprite2D
var npc_list : Array[AnimatedSprite2D]
var stop_signal : bool
var previous_pt : Marker2D
var different_directional_npc : bool 
var other_npc : Node2D = null
var dodge_type : String
var direction: Vector2 = Vector2.ZERO
var dodge_stage : int = 0
var is_dodging = false
var dodge_target : Vector2
var being_dodged = false

const SPEED = 30.0

@export var npc_id : int = 0 
func _ready():
	add_to_group(\"npc\")
	npc_list = [npc_1,npc_2,npc_3,npc_4,npc_5,npc_6]
	npc_name = npc_list.pick_random()
	for npc in npc_list:
		npc.hide()
	npc_name.show()

func _physics_process(delta: float) -> void:
	if near_pt == null:
		return
	
	
	# performing the dodge
	if being_dodged:
		npc_name.play(\"idle \" +last_direction)
		velocity = Vector2.ZERO
		move_and_slide()
		return 
	if is_dodging and dodge_type == \"left and right\":
		velocity = global_position.direction_to(dodge_target) * SPEED
		var distance = global_position.distance_to(dodge_target)
		if dodge_stage == 1:
			npc_name.play(\"top\")
		if distance < 2.0 and dodge_stage == 1:
			dodge_stage = 2
			dodge_target = global_position + Vector2(100,0)
			npc_name.play(\"right\")
		elif distance < 2.0 and dodge_stage == 2:
			dodge_stage = 3
			dodge_target = global_position + Vector2(0,40)
			npc_name.play(\"front\")
		elif distance < 2.0 and dodge_stage == 3:
			is_dodging = false
			dodge_stage = 0
		move_and_slide()
		return
	elif is_dodging and dodge_type == \"front and down\":
		velocity = global_position.direction_to(dodge_target) * SPEED
		var distance = global_position.distance_to(dodge_target)
		if dodge_stage == 1:
			npc_name.play(\"left\")
		if distance < 2.0 and dodge_stage == 1:
			dodge_stage = 2
			dodge_target = global_position + Vector2(0,100)
			npc_name.play(\"front\")
		elif distance < 2.0 and dodge_stage == 2:
			dodge_stage = 3
			dodge_target = global_position + Vector2(40,0)
			npc_name.play(\"right\")
		elif distance < 2.0 and dodge_stage == 3:
			is_dodging = false
			dodge_stage = 0
		move_and_slide()
		return
	elif is_dodging and dodge_type == \"top and right\":
		velocity = global_position.direction_to(dodge_target) * SPEED
		var distance = global_position.distance_to(dodge_target)
		if dodge_stage == 1:
			npc_name.play(\"front\")
		if distance < 2.0 and dodge_stage == 1:
			dodge_stage = 2
			dodge_target = global_position + Vector2(100,0)
			npc_name.play(\"right\")
		elif distance < 2.0 and dodge_stage == 2:
			dodge_stage = 3
			dodge_target = global_position + Vector2(0,-40)
			npc_name.play(\"top\")
		elif distance < 2.0 and dodge_stage == 3:
			is_dodging = false
			dodge_stage = 0
		move_and_slide()
		return


	if different_directional_npc == true:
		if (last_direction == \"right\" and other_npc.last_direction == \"left\") or (last_direction == \"left\" and other_npc.last_direction == \"right\"):
			print(\"right left collided\")
			dodge_type = \"left and right\"
		elif (last_direction == \"top\" and other_npc.last_direction == \"front\") or (last_direction == \"front\" and other_npc.last_direction == \"top\"):
			print(\"top front collided\")
			dodge_type = \"front and down\"
		elif (last_direction == \"top\" and other_npc.last_direction == \"right\") or (last_direction == \"right\" and other_npc.last_direction == \"top\"):
			print(\"front right collided\")
			dodge_type = \"top and right\"
		start_dodge()
		
		
	var distance = global_position.distance_to(near_pt.global_position)
	var direction = global_position.direction_to(near_pt.global_position)
	if distance < 5.0:
		nex_pt()
		return
	check_signal()
	if npc_inside == true or stop_signal == true:
		velocity = Vector2.ZERO
		npc_name.play(\"idle \" + last_direction)
	else:
		velocity = direction * SPEED
		move_and_slide()
		process_animation(direction)


func process_animation(direction: Vector2):

	if dodge_stage == 1:
		return
	if abs(direction.x)>abs(direction.y):
		if direction.x > 0:
			npc_name.play(\"right\")
			last_direction = \"right\"
		else :
			npc_name.play(\"left\")
			last_direction = \"left\"
	else:
		if direction.y > 0:
			npc_name.play(\"front\")
			last_direction = \"front\"
		else :
			npc_name.play(\"top\")
			last_direction = \"top\"

# here we are checking our next pt
func nex_pt():
	previous_pt = near_pt
	if near_pt == pt_1:
		var possible_pt = [pt_3]
		near_pt = possible_pt.pick_random()
	elif near_pt == pt_2:
		var possible_pt = [pt_1]
		near_pt = possible_pt.pick_random()

	elif near_pt == pt_3:
		var possible_pt = [pt_4]
		near_pt = possible_pt.pick_random()

	elif near_pt == pt_4:
		var possible_pt = [pt_3]
		near_pt = possible_pt.pick_random()
func  check_signal():
	stop_signal = false

	# pt1 → pt3
	if previous_pt == pt_1 and near_pt == pt_3:
		if GameData.light == \"red in right\" or GameData.light == \"green in front\":
			stop_signal = true

	# pt2 → pt4
	elif previous_pt == pt_2 and near_pt == pt_4:
		if GameData.light == \"red in right\" or GameData.light == \"green in front\":
			stop_signal = true

	# pt3 → pt1
	elif previous_pt == pt_3 and near_pt == pt_1:
		if GameData.light == \"red in right\" or GameData.light == \"green in front\":
			stop_signal = true

	# pt4 → pt2
	elif previous_pt == pt_4 and near_pt == pt_2:
		if GameData.light == \"red in right\" or GameData.light == \"green in front\":
			stop_signal = true
	# pt2 → pt1
	elif previous_pt == pt_2 and near_pt == pt_1:
		if GameData.light == \"red in front\" or GameData.light == \"green in right\":
			stop_signal = true
	# pt1 → pt2
	elif previous_pt == pt_1 and near_pt == pt_2:
		if GameData.light == \"red in front\" or GameData.light == \"green in right\":
			stop_signal = true
	# pt4 → pt3
	elif previous_pt == pt_4 and near_pt == pt_3:
		if GameData.light == \"red in front\" or GameData.light == \"green in right\":
			stop_signal = true
	# pt3 → pt4
	elif previous_pt == pt_3 and near_pt == pt_4:
		if GameData.light == \"red in front\" or GameData.light == \"green in right\":
			stop_signal = true

func _on_area_2d_body_entered(body: Node2D) -> void:
	if body != self and body.is_in_group(\"npc\"):
		other_npc = body
		different_directional_npc = false
		npc_inside = true
		if self.last_direction != body.last_direction:
			different_directional_npc = true


func _on_area_2d_body_exited(body: Node2D) -> void:
	if body != self and body.is_in_group(\"npc\"):
		npc_inside = false

func start_dodge():
	if dodge_type == \"left and right\" and npc_inside:
		if not is_dodging :
			is_dodging = true
			dodge_stage = 1
			print(dodge_stage)
			other_npc.being_dodged = true
			dodge_target = global_position + Vector2(0 , -40)
			npc_name.play(\"top\")
			return
	elif dodge_type == \"front and down\" and npc_inside:
		if not is_dodging :
			is_dodging = true
			dodge_stage = 1
			print(dodge_stage)
			other_npc.being_dodged = true
			dodge_target = global_position + Vector2(-40 , 0)
			npc_name.play(\"top\")
			return
	elif dodge_type == \"top and right\" and npc_inside:
		if not is_dodging :
			is_dodging = true
			dodge_stage = 1
			print(dodge_stage)
			other_npc.being_dodged = true
			dodge_target = global_position + Vector2(0 , -40)
			npc_name.play(\"front\")
			return
	
"

